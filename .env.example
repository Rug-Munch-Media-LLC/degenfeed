# degenfeed-web — Environment Configuration
# Copy to .env and fill in values (or use gopass)

# API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api
RMI_BACKEND_URL=http://localhost:8000

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/degenfeed

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379

# External services
# Postiz (social scheduler)
POSTIZ_URL=http://localhost:8080

# Farcaster Hub
FARCASTER_HUB_URL=http://localhost:8081

# Feature flags
NEXT_PUBLIC_ENABLE_PREMIUM=false
NEXT_PUBLIC_ENABLE_CREATOR_COINS=false
