# DegenFeed Bridge v0.2.0
# All data sources connect to local services. No API keys required for basic operation.
# The bridge falls back to public instances when local services are unavailable.

# GoToSocial OAuth credentials (optional)
# If provided, the bridge will attempt to authenticate with the local GTS instance.
# If not provided, the bridge fetches from public Mastodon instances instead.
GTS_CLIENT_ID=
GTS_CLIENT_SECRET=

# Neynar API key for Farcaster data (required for Farcaster provider)
# Get one at https://neynar.com/ — the free tier includes 50,000 API calls/month.
# Without this key, the Farcaster provider will skip Neynar API calls and return empty.
NEYNAR_API_KEY=

# Server port (default: 8787)
BRIDGE_PORT=8787

# Bridge API key for internal authentication
# Required by all non-health endpoints. Set via Authorization: Bearer <key> header.
BRIDGE_API_KEY=

# Lens Protocol v2 cross-posting (optional)
# Access token expires in ~10 min; refresh token in ~90 days.
# The bridge auto-refreshes via the refresh token. If both expire, re-authenticate
# via the wallet private key by running the lens-setup script.
# API: https://api.lens.xyz/graphql (migrated from api-v2.lens.dev)
# Account: created on Polygon via Test App (0x8A5Cc31180c37078...)
# Global Feed: 0xcB5E109FFC0E15565082d78E68dDDf2573703580
LENS_API_URL=https://api.lens.xyz/graphql
LENS_ACCESS_TOKEN=
LENS_REFRESH_TOKEN=
LENS_ACCOUNT_ADDRESS=
LENS_FEED_ADDRESS=0xcB5E109FFC0E15565082d78E68dDDf2573703580
LENS_WALLET_PRIVATE_KEY=
