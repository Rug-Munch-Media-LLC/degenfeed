{
  "files": [
    {
      "path": "./apps/web/.next/static/chunks/*.js",
      "maxSize": "500 kB",
      "compression": "gzip"
    },
    {
      "path": "./apps/web/.next/static/**/*.css",
      "maxSize": "75 kB",
      "compression": "gzip"
    }
