{
  "name": "DegenFeed \u2014 Web3 Social Superapp | Cross-Protocol Aggregator",
  "short_name": "DegenFeed",
  "description": "Aggregate Nostr, Farcaster, Lens, Bluesky, Mastodon, Threads, Reddit, RSS into one unified feed. Cross-post across protocols, tip creators in crypto, and own your social network.",
  "start_url": "/feed",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#1d9bf0",
  "orientation": "portrait",
  "categories": [
    "social",
    "news",
    "cryptocurrency",
    "productivity",
    "communication"
  ],
  "lang": "en-US",
  "dir": "ltr",
  "scope": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/feed-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DegenFeed unified timeline showing posts from Nostr, Farcaster, Bluesky, and Lens"
    },
    {
      "src": "/screenshots/feed-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "DegenFeed mobile feed with cross-protocol posts"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/degenfeed/id0000000000"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=xyz.degenfeed.app"
    }
  ],
  "handle_links": "preferred",
  "edge_side_panel": {},
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "note_taking": {
    "new_note_url": "/post/new"
  }
