{
  "name": "degenfeed-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build:ios": "pnpm build && npx cap sync ios && npx cap open ios",
    "cap:build:android": "pnpm build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@degenfeed/auth": "workspace:*",
    "@degenfeed/bluesky-sdk": "workspace:*",
    "@degenfeed/farcaster-sdk": "workspace:*",
    "@degenfeed/feed-core": "workspace:*",
    "@degenfeed/feed-providers": "workspace:*",
    "@degenfeed/identity": "workspace:*",
    "@degenfeed/lens-sdk": "workspace:*",
    "@degenfeed/nostr-sdk": "workspace:*",
    "@degenfeed/peertube-provider": "workspace:*",
    "@degenfeed/ranking": "workspace:*",
    "@degenfeed/realtime": "workspace:*",
    "@degenfeed/source-discovery": "workspace:*",
    "@degenfeed/storage": "workspace:*",
    "@degenfeed/tip-contract": "workspace:*",
    "@degenfeed/types": "workspace:*",
    "@degenfeed/ui": "workspace:*",
    "@degenfeed/utils": "workspace:*",
    "@degenfeed/web3": "workspace:*",
    "@degenfeed/youtube-provider": "workspace:*",
    "dompurify": "^3.2.3",
    "next": "^16.2.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
