# ── DegenFeed Web .env.example ─────────────────────────────────
# Source of truth: standards/templates/env.example.ts.template
# Copy to .env and fill in values for local development.
# DO NOT commit .env — it's in .gitignore.

# ── App URLs ───────────────────────────────────────────────────
# Public URL of this Next.js app (used for OAuth redirects and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the DegenFeed API worker.
# Note: apps/web/src/app/auth/callback/page.tsx currently reads NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# ── Admin Access ────────────────────────────────────────────────
# Comma-separated list of wallet addresses allowed to access /admin/* routes.
# ADMIN_WALLETS is read server-side (middleware, API routes).
# NEXT_PUBLIC_ADMIN_WALLETS is read client-side (admin UI pages) — must be
# available at build time for Next.js to inline it into the client bundle.
# Both should contain the same comma-separated lowercase wallet addresses.
# ADMIN_WALLETS=
# NEXT_PUBLIC_ADMIN_WALLETS=
