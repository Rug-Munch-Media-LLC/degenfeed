# ─── DegenFeed Web — Environment Configuration ───────────────────────────────
# Copy to .env.local and fill in your values.
#   cp apps/web/.env.example apps/web/.env.local
#
# NEXT_PUBLIC_* variables are exposed to the browser.
# All others are server-side only (Next.js API routes + middleware).

# ─── Core ─────────────────────────────────────────────────────────────────────

# HMAC-SHA256 session signing secret (32 bytes hex).
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Comma-separated CORS origins for state-changing requests
ALLOWED_ORIGINS="https://degenfeed.xyz,https://app.degenfeed.xyz,http://localhost:3000"

# Admin wallet addresses (comma-separated, lowercase) for moderation dashboard
ADMIN_WALLETS=""

# ─── API URLs ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL="https://degenfeed.xyz/api"
NEXT_PUBLIC_WORKER_API_URL="https://api.degenfeed.xyz"
NEXT_PUBLIC_WORKER_URL="https://degenfeed.xyz"
NEXT_PUBLIC_API_BASE="https://degenfeed.xyz/api"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ─── Nostr ────────────────────────────────────────────────────────────────────

# Comma-separated relay URLs
RELAY_URLS="wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://relay.nostr.band,wss://nostr.wine"

# Nostr private key hex for publishing events (e.g., kind 30311 livestream)
NOSTR_PRIVATE_KEY=""

# ─── Farcaster ────────────────────────────────────────────────────────────────

# Farcaster Hub HTTP endpoint
FARCASTER_HUB_URL="https://hub.farcaster.standardcrypto.vc:2281"

# Neynar API key for follower counts
NEYNAR_API_KEY=""

# Warpcast OAuth credentials (from https://warpcast.com/~/apps)
FARCASTER_CLIENT_ID=""

# ─── Lens Protocol ────────────────────────────────────────────────────────────

LENS_API_URL="https://api-v2.lens.dev/graphql"

# ─── Bluesky / AT Protocol ───────────────────────────────────────────────────

BSKY_PUBLIC_URL="https://public.api.bsky.app"
BSKY_SOCIAL_URL="https://bsky.social"

# Bluesky DID for AT Protocol posting (e.g., did:plc:abc123)
BSKY_DID=""

# ─── Mastodon / GotoSocial ───────────────────────────────────────────────────

GTS_INSTANCE_URL="https://social.degenfeed.xyz"
GTS_API_BASE="https://social.degenfeed.xyz"
GTS_REDIRECT_URI="https://app.degenfeed.xyz/auth/callback"
GTS_CLIENT_ID=""
GTS_CLIENT_SECRET=""

# ─── Threads (Instagram) / Meta ──────────────────────────────────────────────

THREADS_PDS_URL="https://public.threads.net"
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# ─── YouTube ──────────────────────────────────────────────────────────────────

# YouTube Data API v3 key for channel discovery
YOUTUBE_API_KEY=""

# ─── PeerTube ─────────────────────────────────────────────────────────────────

PEERTUBE_INSTANCE_URL="https://video.degenfeed.xyz"
PEERTUBE_CLIENT_ID=""
PEERTUBE_CLIENT_SECRET=""

# ─── Reddit ───────────────────────────────────────────────────────────────────

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ─── OAuth Providers ──────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TELEGRAM_BOT_NAME=""
TELEGRAM_BOT_TOKEN=""

# ─── Solana ───────────────────────────────────────────────────────────────────

# Solana RPC URL for wallet verification, Blinks, and on-chain data
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Solana program ID for creator coin protocol
SOLANA_PROGRAM_ID=""

# ─── EVM ──────────────────────────────────────────────────────────────────────

# Base chain RPC URLs
BASE_RPC_URL="https://mainnet.base.org"
BASE_SEPOLIA_RPC="https://sepolia.base.org"

# Polygon chain (Lens) RPC URL
POLYGON_RPC_URL="https://polygon-rpc.com"

# ─── Creator Coins ────────────────────────────────────────────────────────────

# Zora wrapper factory contract address (Base)
ZORA_WRAPPER_FACTORY=""

# Premium wallet private key for paying on-chain registration fees
PREMIUM_WALLET_KEY=""

# ─── Cross-Chain Bridge ───────────────────────────────────────────────────────

# Wormhole bridge address for cross-chain tips (Base)
WORMHOLE_BRIDGE=""

# Wormhole relayer endpoint
WORMHOLE_RELAYER=""

# Bridge operator private key
BRIDGE_OPERATOR_KEY=""

# ─── Content Permanence (Pinata IPFS) ─────────────────────────────────────────

PINATA_API_KEY=""
PINATA_SECRET_KEY=""

# ─── VAPID (Web Push Notifications) ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:admin@degenfeed.xyz"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Postmark (Transactional Email) ──────────────────────────────────────────

POSTMARK_SERVER_TOKEN=""

# ─── MeiliSearch ─────────────────────────────────────────────────────────────

MEILI_SEARCH_KEY=""

# ─── Bluesky PDS (Self-Hosted) ────────────────────────────────────────────────

# These are for running your own AT Protocol PDS at pds.degenfeed.xyz
PDS_JWT_SECRET=""
PDS_ADMIN_PASSWORD=""
PDS_PLC_ROTATION_KEY=""

# ─── Infrastructure ───────────────────────────────────────────────────────────

# Self-hosted Redlib instance for Reddit feed proxying
REDLIB_URL="https://redlib.degenfeed.xyz"

# Self-hosted RSS-Bridge instance
RSS_BRIDGE_URL="https://rss-bridge.degenfeed.xyz"
FLARESOLVERR_URL="http://100.104.130.92:8191"

# RMI Backend URL for token risk data
RMI_BACKEND_URL="http://100.104.130.92:8000"
RMI_API_KEY=""

# OpenRouter Websearch key
OPENROUTER_WEBSEARCH_KEY=""

# Error tracking (Sentry-compatible GlitchTip)
SENTRY_DSN=""

# Postiz cross-posting API
POSTIZ_BASE_URL="http://127.0.0.1:3105"
POSTIZ_API_KEY=""
POSTIZ_INTEGRATIONS=""

# Feature flags (comma-separated, defaults enabled)
FEATURE_FLAGS_DEFAULT="reply-composer,dark-mode-only,farcaster-frames"

# Mastodon instance for account creation
MASTODON_INSTANCE_URL="https://social.degenfeed.xyz"

# ─── Feature Flags (browser-exposed) ─────────────────────────────────────────

NEXT_PUBLIC_ADMIN_WALLETS=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─── Deprecated ───────────────────────────────────────────────────────────────

# ADMIN_API_KEY is deprecated — use scoped keys (PUSH_API_KEY, NEWSLETTER_API_KEY)
ADMIN_API_KEY=""
PUSH_API_KEY=""
NEWSLETTER_API_KEY=""
