{
  "name": "degenfeed-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "bash scripts/run-coverage.sh",
    "coverage:ci": "bash scripts/run-coverage.sh --ci",
    "coverage:open": "bash scripts/run-coverage.sh --open",
    "health": "bash scripts/health-check.sh",
    "security:scan": "bash scripts/security-scan.sh",
    "docs:dev": "pnpm --filter @degenfeed/docs dev",
    "docs:build": "pnpm --filter @degenfeed/docs build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy:tip-contract": "tsx scripts/deploy-tip-contract.ts --all",
    "deploy:tip-contract:base": "tsx scripts/deploy-tip-contract.ts --network=base",
    "deploy:tip-contract:optimism": "tsx scripts/deploy-tip-contract.ts --network=optimism",
    "deploy:tip-contract:arbitrum": "tsx scripts/deploy-tip-contract.ts --network=arbitrum",
    "deploy:tip-contract:forge": "forge build --contracts packages/tip-contract/src/DegenFeedTips.sol"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "^6.0.5",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@degenfeed/creator-coin": "workspace:*",
    "@degenfeed/monetization": "workspace:*",
    "@degenfeed/spaces-bridge": "workspace:*",
    "@telegram-apps/sdk": "^3.11.8",
    "swr": "^2.4.2"
  }
}
