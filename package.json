{
  "name": "degenfeed-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "bash scripts/run-coverage.sh",
    "coverage:ci": "bash scripts/run-coverage.sh --ci",
    "coverage:open": "bash scripts/run-coverage.sh --open",
    "health": "bash scripts/health-check.sh",
    "security:scan": "bash scripts/security-scan.sh",
    "docs:dev": "pnpm --filter @degenfeed/docs dev",
    "docs:build": "pnpm --filter @degenfeed/docs build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy:tip-contract": "tsx scripts/deploy-tip-contract.ts --all",
    "deploy:tip-contract:base": "tsx scripts/deploy-tip-contract.ts --network=base",
    "deploy:tip-contract:optimism": "tsx scripts/deploy-tip-contract.ts --network=optimism",
    "deploy:tip-contract:arbitrum": "tsx scripts/deploy-tip-contract.ts --network=arbitrum",
    "deploy:tip-contract:forge": "forge build --contracts packages/tip-contract/src/DegenFeedTips.sol",
    "deps:freshness": "npx npm-check-updates --format group",
    "changeset": "changeset",
    "version:ci": "changeset version",
    "release:ci": "changeset publish",
    "test:workers": "vitest run --include \"tests/workers-integration/**\" --reporter=verbose"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "^6.0.5",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/nextjs": "^10.5.10",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "bundlewatch": "^0.4.2",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "msw": "^2.15.0",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@degenfeed/creator-coin": "workspace:*",
    "@degenfeed/degenchat": "workspace:*",
    "@degenfeed/monetization": "workspace:*",
    "@degenfeed/spaces-bridge": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@telegram-apps/sdk": "^3.11.8",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "^1.6.25",
    "hls.js": "^1.6.16",
    "p2p-media-loader-hlsjs": "^3.0.1",
    "swr": "^2.4.2"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.12.0",
      "axios@0.31.1": "^1.12.0",
      "axios@1.7.7": "^1.12.0",
      "hono": "^4.12.34",
      "undici": "^8.9.0",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.18",
      "qs": "^6.15.2",
      "tmp": "^0.2.6",
      "uuid": "^11.1.1",
      "brace-expansion": "^5.0.9",
      "postcss": "^8.5.23",
      "cookie": "^0.7.0",
      "dompurify": "^3.4.13",
      "vite@5.4.21": "^6.4.3",
      "uuid@8.3.2": "^11.1.1",
      "uuid@9.0.1": "^11.1.1"
    }
  },
  "overrides": {
    "axios": "^1.12.0",
    "axios@0.31.1": "^1.12.0",
    "axios@1.7.7": "^1.12.0",
    "hono": "^4.12.34",
    "undici": "^8.9.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "qs": "^6.15.2",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.23",
    "cookie": "^0.7.0",
    "dompurify": "^3.4.13",
    "vite@5.4.21": "^6.4.3",
    "uuid@8.3.2": "^11.1.1",
    "uuid@9.0.1": "^11.1.1"
  },
  "license": "UNLICENSED"
}
