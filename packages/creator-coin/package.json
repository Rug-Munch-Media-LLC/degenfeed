{
  "name": "@degenfeed/creator-coin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./evm": "./src/evm/client.ts",
    "./solana": "./src/solana/client.ts",
    "./cross-chain": "./src/cross-chain/bridge.ts",
    "./live-stream": "./src/live-stream.ts",
    "./bonding-curve": "./src/bonding-curve.ts",
    "./fees": "./src/fees.ts",
    "./types": "./src/types.ts",
