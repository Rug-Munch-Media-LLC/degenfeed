{
  "name": "@degenfeed/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@degenfeed/realtime": "workspace:*",
    "@degenfeed/storage": "workspace:*",
    "@degenfeed/token-gate": "workspace:*",
    "@degenfeed/types": "workspace:*",
    "@degenfeed/utils": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./protocol-shell": {
      "types": "./dist/protocol-shell/index.d.ts",
      "default": "./dist/protocol-shell/index.js"
    }
  },
  "sideEffects": false
}
