{
  "name": "@degenfeed/chat-super-app",
  "version": "1.0.0",
  "description": "DegenFeed Chat Super-App \u2014 Matrix Hub, Protocol Bridges, E2EE, Self-Destruct, Live Calls",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@degenfeed/crypto": "workspace:*",
    "@degenfeed/types": "workspace:*",
    "@degenfeed/realtime": "workspace:*",
    "@degenfeed/nostr-sdk": "workspace:*",
    "@degenfeed/web3": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
