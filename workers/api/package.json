{
  "name": "@degenfeed/api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/serve.ts",
    "start:node": "node --import tsx src/serve.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@degenfeed/bluesky-sdk": "workspace:*",
    "@degenfeed/farcaster-sdk": "workspace:*",
    "@degenfeed/feed-core": "workspace:*",
    "@degenfeed/feed-providers": "workspace:*",
    "@degenfeed/identity": "workspace:*",
    "@degenfeed/lens-sdk": "workspace:*",
    "@degenfeed/mastodon-sdk": "workspace:*",
    "@degenfeed/nostr-sdk": "workspace:*",
    "@degenfeed/ranking": "workspace:*",
    "@degenfeed/shorts-provider": "workspace:*",
    "@degenfeed/rss-sdk": "workspace:*",
    "@degenfeed/threads-sdk": "workspace:*",
    "@degenfeed/token-gate": "workspace:*",
    "@degenfeed/types": "workspace:*",
    "@degenfeed/utils": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.98.4",
    "hono": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "^4.20240501.0",
    "@hono/node-server": "^1",
    "tsx": "^4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
