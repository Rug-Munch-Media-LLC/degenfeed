    "@degenfeed/lens-sdk": "workspace:*",
    "@degenfeed/livepeer-provider": "workspace:*",
    "@degenfeed/mastodon-sdk": "workspace:*",
    "@degenfeed/mirror-bridge": "workspace:*",
    "@degenfeed/nostr-sdk": "workspace:*",
    "@degenfeed/paragraph-bridge": "workspace:*",
    "@degenfeed/peertube-provider": "workspace:*",
    "@degenfeed/ranking": "workspace:*",
