{
  "name": "@degenfeed/api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/serve.ts",
    "start:node": "node --import tsx src/serve.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --var POSTIZ_API_KEY:${POSTIZ_API_KEY:?POSTIZ_API_KEY env var is required (gopass) - do not rely on the wrangler.toml placeholder}",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@degenfeed/auth": "workspace:*",
    "@degenfeed/bluesky-sdk": "workspace:*",
    "@degenfeed/chat-super-app": "workspace:*",
    "@degenfeed/creator-coin": "workspace:*",
    "@degenfeed/cross-protocol-bridge": "workspace:*",
    "@degenfeed/crossplatform-register": "workspace:*",
    "@degenfeed/crypto": "workspace:*",
    "@degenfeed/farcaster-sdk": "workspace:*",
    "@degenfeed/feed-core": "workspace:*",
    "@degenfeed/feed-providers": "workspace:*",
    "@degenfeed/ghost-bridge": "workspace:*",
    "@degenfeed/identity": "workspace:*",
    "@degenfeed/lemmy-sdk": "workspace:*",
    "@degenfeed/lens-sdk": "workspace:*",
    "@degenfeed/mastodon-sdk": "workspace:*",
    "@degenfeed/mirror-bridge": "workspace:*",
    "@degenfeed/nostr-sdk": "workspace:*",
    "@degenfeed/paragraph-bridge": "workspace:*",
    "@degenfeed/peertube-provider": "workspace:*",
    "@degenfeed/pixelfed-sdk": "workspace:*",
    "@degenfeed/ranking": "workspace:*",
    "@degenfeed/realtime": "workspace:*",
    "@degenfeed/reputation": "workspace:*",
    "@degenfeed/rss-sdk": "workspace:*",
    "@degenfeed/shorts-provider": "workspace:*",
    "@degenfeed/source-discovery": "workspace:*",
    "@degenfeed/telegram-sdk": "workspace:*",
    "@degenfeed/threads-sdk": "workspace:*",
    "@degenfeed/token-gate": "workspace:*",
    "@degenfeed/types": "workspace:*",
    "@degenfeed/utils": "workspace:*",
    "@degenfeed/youtube-provider": "workspace:*",
    "@degenfeed/zora-sdk": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@simplewebauthn/server": "^11.0.0",
    "@solana/web3.js": "^1.99.0",
    "hono": "^4.13.14",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@hono/node-server": "^1.19.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
