# ── DegenFeed API Worker .dev.vars.example ─────────────────────
# Copy to .dev.vars and fill in real values for local development.
# .dev.vars is NOT committed — it holds secrets only.
# For production, use `wrangler secret put <NAME>`.

# Cloudflare API token used by Wrangler for deploys and local dev auth.
CLOUDFLARE_API_TOKEN=

# GotoSocial OAuth2 client secret.
GTS_CLIENT_SECRET=

# Worker HMAC session signing key (generate: openssl rand -hex 32)
AUTH_SECRET=

# Meta Threads API app secret (from Meta Developer Dashboard)
THREADS_APP_SECRET=

# Reddit OAuth app secret
REDDIT_CLIENT_SECRET=

# Postmark server token for transactional email delivery
POSTMARK_SERVER_TOKEN=

# VAPID keys for Web Push (generate: npx web-push generate-vapid-notes)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: RMI backend API key if gated
RMI_API_KEY=

# Optional: Solana RPC URL override
SOLANA_RPC_URL=

# Optional: Sentry DSN for error reporting
SENTRY_DSN=
