# ── DegenFeed API Worker .dev.vars.example ─────────────────────
# Copy to .dev.vars and fill in real values for local development.
# .dev.vars is NOT committed — it holds secrets only.
# For production, use `wrangler secret put <NAME>`.

# Cloudflare API token used by Wrangler for deploys and local dev auth.
CLOUDFLARE_API_TOKEN=

# GotoSocial OAuth2 client secret.
GTS_CLIENT_SECRET=

# Worker HMAC session signing key (generate: openssl rand -hex 32)
AUTH_SECRET=

# Meta Threads API app secret (from Meta Developer Dashboard)
THREADS_APP_SECRET=

# Reddit OAuth app secret
REDDIT_CLIENT_SECRET=

# Postmark server token for transactional email delivery
POSTMARK_SERVER_TOKEN=

# VAPID keys for Web Push (generate: npx web-push generate-vapid-notes)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: RMI backend API key if gated
RMI_API_KEY=

# Fallback/primary rmi-backend API key for persistent storage endpoints (bookmarks, identities, chat, sessions)
RMI_INTERNAL_KEY=

# When "true", rmi-backend API results are authoritative for KV-migrated
# namespaces even when empty. When unset, empty API results fall back to KV.
USE_RMI_API=true

# Queue processing via rmi-backend queue API ("true" default) vs legacy KV list()
USE_RMI_QUEUE_API=true

# Scheduled post executor throttle interval in minutes (default 5)
SCHEDULED_EXECUTOR_INTERVAL_MINUTES=5

# Optional: Solana RPC URL override
SOLANA_RPC_URL=

# Solana devnet RPC URL
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Base Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Premium wallet private key (used for gas on deployments)
# PREMIUM_WALLET_KEY=0x...

# Enable real deployments (set to "true" to enable on-chain deployment)
ENABLE_REAL_DEPLOYMENTS=false

# Factory contract address for creator coin deployments on Base
# COIN_FACTORY_ADDRESS=0x777777751622c0d3258f214F9DF38E35BF45baF3

# Factory contract address for creator coin deployments on Base Sepolia testnet
# COIN_FACTORY_ADDRESS_TESTNET=0x7691e6E14fF349B854738C8A8Aac2314558125B6

# Optional: Sentry DSN for error reporting
SENTRY_DSN=

# ── Postiz cross-posting ──────────────────────────────────────
# Base URL of the Postiz instance (default: http://127.0.0.1:3105)
POSTIZ_BASE_URL=http://127.0.0.1:3105
# API key generated via Postiz UI: Settings > Developers > Public API
POSTIZ_API_KEY=
# JSON map of platform -> Postiz integration ID, e.g.:
# POSTIZ_INTEGRATIONS={"mastodon":"int-abc","bluesky":"int-def"}
