# ═══════════════════════════════════════════════════════════════════════
# DegenFeed Self-Hosted — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with ⚠️
# Optional variables can be left blank for sensible defaults.
#
# Documentation: https://docs.degenfeed.xyz/self-host
# ═══════════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────────────
# ⚠️ Your domain (e.g., alice.xyz) — DNS A record must point to your server
DOMAIN=

# ⚠️ Your wallet address for the creator coin (EVM or Solana)
# EVM:  0x...
# Solana: 4x...
CREATOR_WALLET=

# ── Optional: Identity ─────────────────────────────────────────────────
# Your fediverse handle username (default: "creator")
# You'll be reachable at @username@yourdomain.com
CREATOR_USERNAME=creator

# ── Optional: Creator Coin ─────────────────────────────────────────────
# Pre-deployed coin address (leave blank for auto-deploy)
CREATOR_COIN_ADDRESS=

# Chain for creator coin deployment (base | solana)
CREATOR_COIN_CHAIN=base

# ── Optional: Email (for Let's Encrypt expiry / admin alerts) ─────────
ACME_EMAIL=

# ── Optional: Cross-Protocol Credentials ───────────────────────────────
# Set these to enable cross-posting to other protocols.
# Without them, DegenFeed works as a read-only aggregator.

# Nostr private key hex for publishing events
NOSTR_PRIVATE_KEY=

# Neynar API key for Farcaster follower data
NEYNAR_API_KEY=

# Bluesky DID for AT Protocol posting (e.g., did:plc:abc123)
BSKY_DID=

# GoToSocial OAuth (for ActivityPub posting)
GTS_CLIENT_ID=
GTS_CLIENT_SECRET=

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# Telegram bot token and username
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Optional: Social OAuth Providers ──────────────────────────────────
# Used for sign-in with existing social accounts.
# Register OAuth apps at each provider's developer console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Farcaster (Warpcast) OAuth — register at https://warpcast.com/~/apps
FARCASTER_CLIENT_ID=

# Threads / Meta OAuth
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── Optional: Creator Coins / Web3 ────────────────────────────────────
# RPC URLs for on-chain data
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Zora wrapper factory contract (Base)
ZORA_WRAPPER_FACTORY=

# Premium wallet private key (for paying registration fees)
PREMIUM_WALLET_KEY=

# ── Optional: Push Notifications (Web Push / VAPID) ──────────────────
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@${DOMAIN}

# ── Optional: Admin ───────────────────────────────────────────────────
# Comma-separated wallet addresses with admin access
ADMIN_WALLETS=

# ── Optional: Branding / White-Label ─────────────────────────────────
# Set WHITE_LABEL=true to remove "Powered by DegenFeed" branding
WHITE_LABEL=false
# Custom color scheme (hex color for primary brand color)
BRAND_COLOR=
# Custom favicon URL
CUSTOM_FAVICON=

# ── Optional: Image Tag ──────────────────────────────────────────────
# Docker image tag (default: latest, use specific versions like v0.1.0 for pinned deploys)
IMAGE_TAG=latest

# ── Optional: Cloudflare Tunnel ──────────────────────────────────────
# Instead of opening ports 80/443, use Cloudflare Argo Tunnel.
# See cloudflared-setup.sh for instructions.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional: External Services ──────────────────────────────────────
# Error tracking (Sentry-compatible GlitchTip)
SENTRY_DSN=

# Transactional email (Postmark)
POSTMARK_SERVER_TOKEN=

# OpenRouter API key (for search/ai features)
OPENROUTER_WEBSEARCH_KEY=
