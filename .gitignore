# TypeScript / Node .gitignore — Rug Munch Media fleet standard
# See https://git.rugmunch.io/RugMunchMedia/standards for source of truth.
# ── Secrets (zero tolerance) ───────────────────────────────────
.env
.env.*
.envrc
.dev.vars
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.session
credentials.json
service-account.json
.secrets/
# ── Node ───────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
yarn-error.log
yarn-debug.log
# ── Build artifacts ────────────────────────────────────────────
dist/
build/
.next/
# ── Generated seed data ──────────────────────────────────────
/scripts/seed-data/
.turbo/
out/
*.tsbuildinfo
# ── Coverage ───────────────────────────────────────────────────
coverage/
*.lcov
# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
# ── Logs ───────────────────────────────────────────────────────
*.log
logs/
pnpm-debug.log*
# ── Solana/Rust build artifacts ────────────────────────────────
target/
*.so
*.rlib
*.d
# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
*.egg-info/
# ── Cache / temp / backups ─────────────────────────────────────
.cache/
tmp/
.vercel/
*.tmp.vercel/
*.bak
*.backup*
# Proprietary files moved to private fleet-infra
CLOUDFLARE.md
docs/DEGENFEED_RESTORE_PROCEDURE.md
docs/NETWORK_OWNERSHIP.md
docs/OWNERSHIP.md
GAPS.md
REMAINING.md
docs/BRIDGE_ARCHITECTURE.md
docs/ENTERPRISE_DEPLOYMENT.md
# Missing common patterns (added by fleet standardization)
.pytest_cache/
.ruff_cache/
.nuxt/
htmlcov/
Thumbs.db

playwright-report/
.env.bridge
.git-blame-ignore-revs

# tsc emit artifacts in SDK packages (source is .ts; main → ./src/index.ts)
packages/farcaster-sdk/src/*.js
packages/farcaster-sdk/src/*.d.ts
packages/farcaster-sdk/src/*.map
packages/lens-sdk/src/*.js
packages/lens-sdk/src/*.d.ts
packages/lens-sdk/src/*.map

# agent session artifacts never get committed
docs/SESSION_TODO.md
apps/docs/.docusaurus/
.methodology-patterns
