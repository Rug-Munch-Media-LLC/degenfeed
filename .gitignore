# TypeScript / Node .gitignore — Rug Munch Media fleet standard
# See https://git.rugmunch.io/RugMunchMedia/standards for source of truth.

# ── Secrets (zero tolerance) ───────────────────────────────────
.env
.env.*
.envrc
.dev.vars
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.session
credentials.json
service-account.json
.secrets/

# ── Node ───────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
yarn-error.log
yarn-debug.log

# ── Build artifacts ────────────────────────────────────────────
dist/
build/
.next/
.turbo/
out/
*.tsbuildinfo

# ── Coverage ───────────────────────────────────────────────────
coverage/
*.lcov

# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Logs ───────────────────────────────────────────────────────
*.log
logs/
pnpm-debug.log*

# ── Cache / temp / backups ─────────────────────────────────────
.cache/
tmp/
.vercel/
*.tmp.vercel/
*.bak
