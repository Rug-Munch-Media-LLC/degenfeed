# Cinnabox build directory — ignore user/desktop state
# Only canonical docs + fleet state files are tracked.

# Desktop / user
.Xauthority
.aider.chat.history.md
.aider.input.history
.aider.models.settings.yml

# Tools / runtimes
.local/
.hermes/.hermes_history
.hermes/state.db*
.hermes/auth.lock
.hermes/cache/
.hermes/logs/

# Secrets (zero tolerance)
.env
.env.*
.dev.vars
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.session
credentials.json
service-account.json
.secrets/

# Node
node_modules/
.npm/
.pnpm-store/
yarn-error.log
yarn-debug.log

# Build artifacts
dist/
build/
.next/
.turbo/
out/
*.tsbuildinfo

# Coverage
coverage/
*.lcov

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Shell history
.bash_history
.zsh_history

# Logs
*.log
logs/
pnpm-debug.log*

